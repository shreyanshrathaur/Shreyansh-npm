{
  "name": "@shreyansh/shapewatch",
  "version": "0.1.0",
  "description": "Zero-dependency runtime API response shape drift detection",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shapewatch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./storage/memory": {
      "import": {
        "types": "./dist/storage/memory.d.ts",
        "default": "./dist/storage/memory.js"
      },
      "require": {
        "types": "./dist/storage/memory.d.cts",
        "default": "./dist/storage/memory.cjs"
      }
    },
    "./storage/file": {
      "import": {
        "types": "./dist/storage/file.d.ts",
        "default": "./dist/storage/file.js"
      },
      "require": {
        "types": "./dist/storage/file.d.cts",
        "default": "./dist/storage/file.cjs"
      }
    },
    "./storage/localstorage": {
      "import": {
        "types": "./dist/storage/localstorage.d.ts",
        "default": "./dist/storage/localstorage.js"
      },
      "require": {
        "types": "./dist/storage/localstorage.d.cts",
        "default": "./dist/storage/localstorage.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); fs.rmSync('coverage', {recursive:true, force:true});\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run build && npm test && npm run test:coverage",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreyanshrathaur/Shreyansh-npm.git"
  },
  "keywords": [
    "api",
    "shape",
    "drift",
    "runtime",
    "fetch",
    "axios",
    "schema",
    "monitoring"
  ],
  "author": "Shreyansh",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
